# ──────────────────────────────────────────────
# Unibot Backend — .gitignore
# ──────────────────────────────────────────────

# Environment
.env
*.env.*
!*.env.example

# Python Virtual Environment
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Logs
*.log
logs/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# Ruff / Linters
.ruff_cache/
